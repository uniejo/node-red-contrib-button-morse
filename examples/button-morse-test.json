[
    {
        "id": "bm_comment",
        "type": "comment",
        "name": "Test without a Raspberry Pi: click 'down' then 'up' = one press",
        "info": "Each down + up click is one button press.\n\nDot length is set to 1000 ms to make mouse clicking easy:\n- press shorter than 0.5 s = dot, longer than 1.5 s = dash\n- pause 3 s = end of letter, 7 s = end of word, 12 s = end of sentence\n\nTry SOS: three quick presses, wait 3 s, three long presses, wait 3 s, three quick presses, then wait 12 s.\n\nOn a Raspberry Pi, replace the two Inject nodes with a GPIO input node (0 = down, 1 = up).",
        "x": 260,
        "y": 60,
        "wires": []
    },
    {
        "id": "bm_inject_down",
        "type": "inject",
        "name": "down",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "0",
        "payloadType": "num",
        "x": 110,
        "y": 120,
        "wires": [["bm_node"]]
    },
    {
        "id": "bm_inject_up",
        "type": "inject",
        "name": "up",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "1",
        "payloadType": "num",
        "x": 110,
        "y": 160,
        "wires": [["bm_node"]]
    },
    {
        "id": "bm_node",
        "type": "button-morse",
        "name": "",
        "dotLength": 1000,
        "sendProgress": true,
        "invert": false,
        "x": 300,
        "y": 140,
        "wires": [["bm_debug_all", "bm_switch"]]
    },
    {
        "id": "bm_debug_all",
        "type": "debug",
        "name": "all events",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 520,
        "y": 120,
        "wires": []
    },
    {
        "id": "bm_switch",
        "type": "switch",
        "name": "letter / sentence end",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            { "t": "eq", "v": "letter_end", "vt": "str" },
            { "t": "eq", "v": "sentence_end", "vt": "str" }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 560,
        "y": 180,
        "wires": [["bm_debug_text"], ["bm_debug_sentence"]]
    },
    {
        "id": "bm_debug_text",
        "type": "debug",
        "name": "text so far",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload.text",
        "targetType": "msg",
        "statusVal": "payload.text",
        "statusType": "auto",
        "x": 810,
        "y": 160,
        "wires": []
    },
    {
        "id": "bm_debug_sentence",
        "type": "debug",
        "name": "sentence",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload.sentence",
        "targetType": "msg",
        "statusVal": "payload.sentence",
        "statusType": "auto",
        "x": 800,
        "y": 200,
        "wires": []
    }
]
